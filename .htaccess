# Ibero Chamber — sitio estático
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# La antigua portada del WordPress
Redirect 301 /inicio/ /
Redirect 301 /servicios/ferias-y-exposiciones/ /servicios/ferias-exposiciones-y-eventos/
Redirect 301 /oficina-de-representacion-en-brasil/ /oficina-en-brasil/
Redirect 301 /formacion/ /formacion-profesional/

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
